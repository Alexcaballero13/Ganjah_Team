# Perfil de producción (no copiar valores reales al repositorio)
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST_POSTGRESQL_PREVIEW:6543/BASE_PREVIEW?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=USUARIO_POSTGRESQL_PREVIEW
SPRING_DATASOURCE_PASSWORD=CONTRASENA_DE_SUPABASE
DB_POOL_SIZE=3
DB_MIN_IDLE=1

# Credenciales internas entre Next.js y Spring Boot
GANJAH_ADMIN_USER=REEMPLAZAR
GANJAH_ADMIN_USER_ALT=REEMPLAZAR
GANJAH_ADMIN_PASSWORD=REEMPLAZAR
GANJAH_ADMIN_PASSWORD_ALT=REEMPLAZAR
GANJAH_VIEWER_USER=REEMPLAZAR
GANJAH_VIEWER_PASSWORD=REEMPLAZAR
