# Perfil de producción (no copiar valores reales al repositorio)
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST_DE_SUPABASE:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=USUARIO_DE_SUPABASE
SPRING_DATASOURCE_PASSWORD=CONTRASENA_DE_SUPABASE
DB_POOL_SIZE=3
DB_MIN_IDLE=1

# Credenciales internas entre Next.js y Spring Boot
GANJAH_ADMIN_USER=REEMPLAZAR
GANJAH_ADMIN_PASSWORD=REEMPLAZAR
GANJAH_VIEWER_USER=REEMPLAZAR
GANJAH_VIEWER_PASSWORD=REEMPLAZAR
